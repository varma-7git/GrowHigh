# Copy this file to .env and fill the values. .env is never committed.
SECRET_KEY=change-this-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

DB_NAME=growhigh
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

DEFAULT_FROM_EMAIL=GrowHigh <noreply@growhigh.local>

# Real emails (forgot password, alerts to admin). Leave empty to print emails in the terminal instead.
# Gmail: turn on 2-step verification, create an "App password", and paste it below (no spaces).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
